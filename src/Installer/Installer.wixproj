<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <BaseOutputPath>..\..\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)\build\</OutputPath>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <BindVariable Include="WixUILicenseRtf=EULA\a2p_EULA.rtf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Sql.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <ProjectReference Include="..\WinForm\WinForm.csproj" />
  </ItemGroup>
</Project>